{
  "commands": [
    {
      "id": "observe-existing-final-application-owner",
      "runtime": "control",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/await_final_application.py"
      ],
      "timeout": 90100
    },
    {
      "id": "register-supported-domain-boundary-reference-contract",
      "runtime": "control",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/register_application_domain_change.py"
      ],
      "timeout": 120
    },
    {
      "id": "capture-eight-native-supported-domain-change-references",
      "runtime": "torch",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/capture_application_domain_change.py",
        "--output",
        "runs/full-ai-next-priorities-v1/application-domain-change-reference-01"
      ],
      "timeout": 3000
    },
    {
      "id": "bind-actual-piecewise-native-geometry-references",
      "runtime": "control",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/register_application_domain_change_qualification.py"
      ],
      "timeout": 120
    },
    {
      "id": "qualify-all-four-actual-models-on-eight-domain-change-scenes",
      "runtime": "torch",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/qualify_application_domain_change.py",
        "--output",
        "runs/full-ai-next-priorities-v1/application-domain-change-qualification-01"
      ],
      "timeout": 3600
    },
    {
      "id": "publish-supported-boundary-regeneration-and-errors",
      "runtime": "control",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/report_application_domain_change.py"
      ],
      "timeout": 120
    }
  ]
}
