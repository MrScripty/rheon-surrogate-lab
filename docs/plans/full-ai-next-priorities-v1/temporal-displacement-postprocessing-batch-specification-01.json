{
  "commands": [
    {
      "id": "observe-existing-fit-batch",
      "runtime": "control",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/await_displacement_batch.py"
      ],
      "timeout": 7250
    },
    {
      "id": "fixed-window-fitting-diagnosis",
      "runtime": "torch",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/diagnose_displacement.py",
        "--pair",
        "runs/full-ai-next-priorities-v1/b2-displacement-pair-01",
        "--output",
        "runs/full-ai-next-priorities-v1/temporal-displacement-fitting-diagnosis-01.json"
      ],
      "timeout": 600
    },
    {
      "id": "audit-and-summarize-full-state-results",
      "runtime": "torch",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/summarize_displacement.py"
      ],
      "timeout": 300
    },
    {
      "id": "balanced-CPU-cost-comparison",
      "runtime": "control",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/benchmark_displacement.py",
        "--bank",
        "runs/full-ai-next-priorities-v1/temporal-development-240-01/bank.json",
        "--output",
        "runs/full-ai-next-priorities-v1/temporal-displacement-timing-01"
      ],
      "timeout": 1800
    },
    {
      "id": "publish-CPU-cost-and-accuracy",
      "runtime": "torch",
      "arguments": [
        "experiments/full-ai-next-priorities-v1/report_displacement_cost.py"
      ],
      "timeout": 300
    }
  ]
}
