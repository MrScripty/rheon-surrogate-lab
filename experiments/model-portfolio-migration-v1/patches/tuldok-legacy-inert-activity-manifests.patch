diff --git a/projects.py b/projects.py
index 4a55f85..5860d84 100644
--- a/projects.py
+++ b/projects.py
@@ -105,6 +105,22 @@ def manifest(value):
     return value
 
 
+def decode_retained_manifest(value):
+    """Keep the closed schema1 activity field as inert historical content.
+
+    Current registration still uses manifest(), which does not accept this
+    retired field. Reading a retained manifest grants no activity-file access.
+    """
+    import copy
+    if type(value) is dict and value.get('schema_version') == 1 and 'activity_path' in value:
+        relative_path(value['activity_path'])
+        current = {key: item for key, item in value.items() if key != 'activity_path'}
+        manifest(current)
+    else:
+        manifest(value)
+    return copy.deepcopy(value)
+
+
 def decode_retained_snapshot(value):
     """Validate immutable registration facts without binding any current root."""
     import copy
@@ -115,7 +131,7 @@ def decode_retained_snapshot(value):
     if type(value['manifest_sha256']) is not str or not SHA.fullmatch(value['manifest_sha256']):raise WorkbenchError('Invalid retained manifest hash.')
     root=value['root_identity']
     if type(root) is not list or len(root)!=2 or any(type(number) is not int or number<0 for number in root):raise WorkbenchError('Invalid historical root identity.')
-    document=manifest(value['manifest'])
+    document=decode_retained_manifest(value['manifest'])
     if document['id']!=value['id'] or document['name']!=value['name']:raise WorkbenchError('Retained snapshot manifest identity differs.')
     return copy.deepcopy(value)
 
diff --git a/tests/test_project_extraction.py b/tests/test_project_extraction.py
