From 1bbb31197772d45bcb0b273ad9013da0d1e554e9 Mon Sep 17 00:00:00 2001
From: MrScripty <TheEnvironmentGuy@protonmail.com>
Date: Sat, 24 Oct 2026 08:48:17 -0700
Subject: [PATCH] Decode original pre-link Torch manifests as inert retained
 evidence

---
 project_material.py         | 12 ++++++------
 tests/test_torch_runtime.py | 21 +++++++++++++++++++++
 torch_runtime.py            | 27 ++++++++++++++++++++++++---
 3 files changed, 51 insertions(+), 9 deletions(-)

diff --git a/project_material.py b/project_material.py
index 4ddd29a2..194e91a5 100644
--- a/project_material.py
+++ b/project_material.py
@@ -277,8 +277,8 @@ def decode_runtime_material(value, *, catalog_id):
             from recipe_process import validate_cpu_snapshot_manifest,encoded
             manifest=validate_cpu_snapshot_manifest(descriptor,value['manifest'])
         elif descriptor.get('profile') == 'managed_torch_python_v1':
-            from torch_runtime import verify_descriptor,encoded
-            manifest=verify_descriptor(descriptor,value['manifest'])
+            from torch_runtime import verify_retained_descriptor,encoded
+            manifest=verify_retained_descriptor(descriptor,value['manifest'])
         else: raise WorkbenchError('Unsupported retained runtime profile.', 'unsupported', 409)
         raw=encoded(manifest)
         if len(raw)!=descriptor['manifest_bytes'] or hashlib.sha256(raw).hexdigest()!=descriptor['manifest_sha256']:
@@ -440,8 +440,8 @@ class ProjectMaterial:
                 from recipe_process import decode, encoded, validate_cpu_manifest
                 manifest = validate_cpu_manifest(decode(raw))
             else:
-                from torch_runtime import decode, encoded, validate_manifest
-                manifest = validate_manifest(decode(raw))
+                from torch_runtime import decode, encoded, validate_retained_manifest
+                manifest = validate_retained_manifest(decode(raw))
             if encoded(manifest) != raw: raise WorkbenchError('Retained runtime manifest encoding differs.', 'invalid', 400)
         return value
 
@@ -581,8 +581,8 @@ class ProjectMaterial:
                 from recipe_process import decode,validate_cpu_manifest
                 manifest=validate_cpu_manifest(decode(manifest_raw))
             else:
-                from torch_runtime import decode,validate_manifest
-                manifest=validate_manifest(decode(manifest_raw))
+                from torch_runtime import decode,validate_retained_manifest
+                manifest=validate_retained_manifest(decode(manifest_raw))
         runtime=self.capture_runtime(dict(ref=ref,descriptor=descriptor,
             environment=None if descriptor is not None else environment,manifest=manifest),manifest_raw)
         return [*self.declarations(runtime),runtime]
diff --git a/tests/test_torch_runtime.py b/tests/test_torch_runtime.py
index c93d202b..03fe4089 100644
--- a/tests/test_torch_runtime.py
+++ b/tests/test_torch_runtime.py
@@ -89,6 +89,27 @@ class InstalledAssets(unittest.TestCase):
         with self.assertRaises(Cancelled):runtime.file_record(Path(self.config['python']),checkpoint=checkpoint)
         self.assertEqual(len(calls),2)
 
+    def test_retained_prelink_manifest_keeps_exact_hash_without_current_launch_authority(self):
+        from pipeline import digest
+        from project_material import decode_runtime_material
+        manifest=runtime.inventory(self.config);manifest.pop('file_links')
+        raw=runtime.encoded(manifest)
+        descriptor=dict(schema_version=1,profile=runtime.PROFILE,catalog_id='a'*32,
+                        manifest_sha256=runtime.sha(raw),manifest_bytes=len(raw),
+                        file_count=len(manifest['files']),total_bytes=manifest['total_bytes'])
+        with self.assertRaisesRegex(ValueError,'closed manifest'):
+            runtime.verify_descriptor(descriptor,manifest)
+        path=Path(self.temp.name)/'old-manifest.json';path.write_bytes(raw)
+        with self.assertRaisesRegex(ValueError,'closed manifest'):runtime.load(path)
+        value=dict(ref=dict(kind='runtime',catalog_id='a'*32,id=digest(descriptor),sha256=digest(descriptor)),
+                   descriptor=descriptor,environment=None,manifest=manifest)
+        self.assertEqual(decode_runtime_material(value,catalog_id='a'*32),value)
+        self.assertEqual(runtime.verify_retained_descriptor(descriptor,manifest),manifest)
+        self.assertNotIn('file_links',manifest)
+        changed=dict(manifest,unknown_field=[])
+        with self.assertRaises(ValueError):runtime.verify_retained_descriptor(descriptor,changed)
+        with self.assertRaises(ValueError):runtime.verify_retained_descriptor(dict(descriptor,manifest_sha256='f'*64),manifest)
+
     def test_manifest_link_noncanonical_encoding_and_descriptor_mismatch_are_rejected(self):
         manifest=runtime.inventory(self.config);raw=runtime.encoded(manifest)
         root=Path(self.temp.name);path=root/'manifest.json';path.write_bytes(raw)
diff --git a/torch_runtime.py b/torch_runtime.py
index f664b9fe..e20cb384 100644
--- a/torch_runtime.py
+++ b/torch_runtime.py
@@ -199,9 +199,20 @@ def validate_descriptor(value):
     return value
 
 
-def verify_descriptor(value,manifest):
-    """Bind a captured manifest to the catalog descriptor before installed asset reads."""
-    validate_descriptor(value);validate_manifest(manifest)
+def validate_retained_manifest(value):
+    """Validate original pre-link inventories solely as historical evidence.
+
+    The measured bytes keep their original shape/hash. Current load and launch
+    still require validate_manifest and its explicit link inventory.
+    """
+    if type(value) is dict and 'file_links' not in value:
+        validate_manifest(dict(value,file_links=[]))
+        return value
+    return validate_manifest(value)
+
+
+def _verify_descriptor(value,manifest,validate):
+    validate_descriptor(value);validate(manifest)
     raw=encoded(manifest)
     require(value['manifest_sha256']==sha(raw) and value['manifest_bytes']==len(raw)
             and value['file_count']==len(manifest['files']) and value['total_bytes']==manifest['total_bytes'],
@@ -209,6 +220,16 @@ def verify_descriptor(value,manifest):
     return manifest
 
 
+def verify_descriptor(value,manifest):
+    """Bind a captured manifest to the catalog descriptor before installed asset reads."""
+    return _verify_descriptor(value,manifest,validate_manifest)
+
+
+def verify_retained_descriptor(value,manifest):
+    """Bind an original current or pre-link manifest without granting execution."""
+    return _verify_descriptor(value,manifest,validate_retained_manifest)
+
+
 def launch(path,device,entry,arguments):
     require(device in ('cpu','cuda'),'explicit CPU or CUDA device')
     value=load(path)
-- 
2.43.0

