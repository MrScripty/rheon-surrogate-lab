From: MrScripty <TheEnvironmentGuy@protonmail.com>
Date: Sat, 24 Oct 2026 09:36:30 -0700
Subject: [PATCH] Use fixed material views for Study history reconstruction

---
 project_study_execution.py            |  7 +++----
 tests/test_project_study_execution.py | 25 +++++++++++++++++++++++++
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/project_study_execution.py b/project_study_execution.py
index 9e19b3c2..561c4779 100644
--- a/project_study_execution.py
+++ b/project_study_execution.py
@@ -16,7 +16,7 @@ from model_definitions import natural, text
 from pipeline import closed, identifier, digest
 from project_history import (FAMILY_FORMATS, _audit, _sha, envelope,
     decode_records as history_records)
-from project_material import ProjectMaterial
+from project_material import ProjectMaterial, MaterialSnapshot
 from project_session import operation_records
 from workbench import WorkbenchError, encode, timestamp
 
@@ -36,8 +36,7 @@ def _invalid(message,code='invalid'):
 
 
 def _facts(records):
-    view=SimpleNamespace(snapshot={'records':records},check=lambda:None)
-    return history_records(records,materials=ProjectMaterial(view))
+    return history_records(records,materials=MaterialSnapshot(records))
 
 
 def _intent_key(operation,key):
@@ -325,7 +324,7 @@ class ProjectStudyExecution:
 
     def _canonical(self,records=None):
         records=self.session.snapshot['records'] if records is None else records
-        return history_records(records,materials=self.materials)
+        return history_records(records,materials=self.materials.read_view(records))
 
     def restore_authoring(self,records=None):
         """Reconstruct intent only, under the current project guard."""
diff --git a/tests/test_project_study_execution.py b/tests/test_project_study_execution.py
index 321cae09..7227e00d 100644
--- a/tests/test_project_study_execution.py
+++ b/tests/test_project_study_execution.py
@@ -95,6 +95,31 @@ class CandidatePreparationContractTests(unittest.TestCase):
 
 
 class StudyExecutionCodecTests(unittest.TestCase):
+    def test_canonical_reconstruction_uses_one_selected_material_view(self):
+        records=[];view=object();calls=[]
+        class Materials:
+            def read_view(self,selected):
+                calls.append(selected);return view
+        adapter=ProjectStudyExecution.__new__(ProjectStudyExecution)
+        adapter.session=SimpleNamespace(snapshot={'records':records});adapter.materials=Materials()
+        def decoded(selected,*,materials):
+            self.assertIs(selected,records);self.assertIs(materials,view);return 'selected facts'
+        with patch('project_study_execution.history_records',side_effect=decoded):
+            self.assertEqual(adapter._canonical(),'selected facts')
+            self.assertEqual(adapter._canonical(records),'selected facts')
+        self.assertEqual(len(calls),2)
+        self.assertTrue(all(selected is records for selected in calls))
+
+    def test_fixed_record_validation_has_no_live_material_session(self):
+        import project_study_execution as owner
+        from project_material import MaterialSnapshot
+        records=[]
+        def decoded(selected,*,materials):
+            self.assertIs(selected,records);self.assertIsInstance(materials,MaterialSnapshot);return 'fixed facts'
+        with patch('project_study_execution.ProjectMaterial',side_effect=AssertionError('No live material lookups')), \
+             patch('project_study_execution.history_records',side_effect=decoded):
+            self.assertEqual(owner._facts(records),'fixed facts')
+
     def test_admission_has_only_exact_reservation_and_references(self):
         value=trial('9'*32,'3'*32)['document']['trial'];composition=Materials().recipe(value['material'])
         charge=composition['material']['resource_envelope']
